{
  "name": "GenerationJob",
  "description": "Tracks a server-side Dream Partner Blueprint generation run across all 7 phases",
  "type": "object",
  "properties": {
    "formData": {
      "type": "object",
      "description": "All wizard inputs: name, nicheBase, niche, geo, client, challenge, years, email",
      "required": true
    },
    "basePrompts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          }
        }
      },
      "description": "Array of { id, title, prompt } for all 7 phases, built by frontend promptBuilder",
      "required": true
    },
    "phaseResults": {
      "type": "object",
      "description": "Phase results keyed by phase ID string: { '1': '...', '2': '...', ... }",
      "required": true,
      "default": {}
    },
    "phaseTiming": {
      "type": "object",
      "description": "Timing data keyed by phase ID string: { '1': { startedAt, completedAt, durationMs }, ... }"
    },
    "currentPhase": {
      "type": "integer",
      "description": "Which phase is actively running. 0=not started, 1-7=running, 8=complete",
      "required": true,
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "complete",
        "failed",
        "cancelled"
      ],
      "description": "Current job status",
      "required": true,
      "default": "queued"
    },
    "phaseAttempts": {
      "type": "array",
      "description": "Diagnostic log, one entry per phase call attempt. Kept so a hung or slow phase can be inspected after the fact: which model, when it started, how long it ran, and how it ended.",
      "items": {
        "type": "object",
        "properties": {
          "phaseId": {
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "maxTokens": {
            "type": "integer"
          },
          "thinkingDisabled": {
            "type": "boolean"
          },
          "promptChars": {
            "type": "integer"
          },
          "startedAt": {
            "type": "string"
          },
          "endedAt": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "userEmail": {
      "type": "string",
      "description": "Email for Resend delivery. Empty string if user skipped email.",
      "required": false,
      "default": ""
    },
    "completedAt": {
      "type": "string",
      "description": "ISO timestamp when status became complete",
      "required": false
    },
    "errorPhase": {
      "type": "integer",
      "description": "Which phase failed, if any",
      "required": false
    },
    "errorMessage": {
      "type": "string",
      "description": "Error details, if any",
      "required": false
    },
    "lastHealTriggerAt": {
      "type": "string",
      "description": "ISO timestamp of the last automatic re-trigger issued when a phase-chain trigger appeared to have dropped",
      "required": false
    }
  },
  "required": [
    "formData",
    "basePrompts",
    "phaseResults",
    "currentPhase",
    "status"
  ]
}